# AWS Configuration for Spark-ling
# Copy this file to .env and fill in your values:
#   cp aws/.env.example aws/.env

# === Required ===
AWS_REGION=ap-southeast-1
AWS_ACCOUNT_ID=085587597183

# === S3 ===
S3_BUCKET=sparkling-data-test

# === EMR (optional — for cluster-based jobs) ===
EMR_CLUSTER_NAME=sparkling-cluster
EMR_RELEASE_LABEL=emr-6.15.0
EMR_MASTER_INSTANCE=m5.xlarge
EMR_CORE_INSTANCE=m5.xlarge
EMR_CORE_COUNT=2
EMR_KEY_PAIR=your-key-pair-name
EMR_SUBNET_ID=subnet-xxxxxxxx

# === Databricks on AWS (optional) ===
DATABRICKS_HOST=https://dbc-a460ab68-eabd.cloud.databricks.com
DATABRICKS_TOKEN=your-databricks-token-here
DATABRICKS_WAREHOUSE_ID=f31ee3e8261856ac

# === MCP Server EC2 (optional) ===
MCP_EC2_INSTANCE_TYPE=t3.small
