# GCP Configuration for Spark-ling
# Copy this file to .env and fill in your values:
#   cp gcp/.env.example gcp/.env

# === Required ===
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-southeast1
GCP_ZONE=asia-southeast1-a

# === GCS ===
GCS_BUCKET=sparkling-data-${GCP_PROJECT_ID}

# === Dataproc Cluster ===
DATAPROC_CLUSTER=sparkling-cluster
DATAPROC_IMAGE_VERSION=2.1-debian11
DATAPROC_MASTER_MACHINE=n1-standard-4
DATAPROC_WORKER_MACHINE=n1-standard-4
DATAPROC_NUM_WORKERS=2
DATAPROC_MAX_IDLE=30m
