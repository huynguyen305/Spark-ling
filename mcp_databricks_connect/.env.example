# ────────────────────────────────────────────────────────────
# Databricks Connect MCP Server — Environment Configuration
# ────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp mcp_databricks_connect/.env.example mcp_databricks_connect/.env

# ── Databricks Connection (required) ────────────────────────
DATABRICKS_HOST=https://dbc-XXXXXXXX-XXXX.cloud.databricks.com
DATABRICKS_TOKEN=dapi...your-personal-access-token...

# ── Compute (optional) ──────────────────────────────────────
# Omit DATABRICKS_CLUSTER_ID to use serverless compute (recommended).
# Set it to attach to a specific interactive cluster instead.
# DATABRICKS_CLUSTER_ID=0101-123456-abcdef

# ── Unity Catalog defaults ──────────────────────────────────
DATABRICKS_CATALOG=sparkling
DATABRICKS_SCHEMA=banking

# ── S3 bucket for raw data reads ────────────────────────────
# Used by the read_s3_path tool when given relative paths.
S3_BUCKET=sparkling-data-test

# ── MCP Server settings ─────────────────────────────────────
# Transport: stdio (local IDE) | sse (remote) | streamable-http
MCP_TRANSPORT=stdio

# Port for SSE / streamable-http (not used in stdio mode)
MCP_PORT=8081

# Server name shown in MCP clients
MCP_SERVER_NAME=sparkling-spark-engine

# Log level: DEBUG | INFO | WARNING
MCP_LOG_LEVEL=INFO
