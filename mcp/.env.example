# MCP Configuration for Spark-ling
# Copy this file to .env and fill in your values:
#   cp mcp/.env.example mcp/.env

# ═══ Backend Selection ═══
# Choose: "databricks", "athena", "s3", or "auto"
# auto tries: Databricks → Athena → S3
MCP_BACKEND=auto

# ═══ Transport Mode ═══
# stdio  — local IDE integration (default, no network)
# sse    — remote EC2/ECS deployment (Server-Sent Events)
# streamable-http — modern MCP HTTP transport
MCP_TRANSPORT=stdio
MCP_PORT=8080
MCP_HOST=0.0.0.0

# ═══ Authentication (remote deployments only) ═══
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MCP_API_KEY=your-secret-key-here

# ═══ Databricks Backend ═══
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=dapi-xxxxxxxxxxxxxxxx
# DATABRICKS_WAREHOUSE_ID=xxxxxxxxxxxxxxxx
# DATABRICKS_CATALOG=sparkling
# DATABRICKS_SCHEMA=banking

# ═══ AWS / S3 Backend ═══
S3_BUCKET=sparkling-data-test
AWS_REGION=ap-southeast-1
# AWS credentials are read from ~/.aws/credentials or IAM role

# ═══ Athena Backend (recommended for AWS) ═══
ATHENA_DATABASE=sparkling
ATHENA_WORKGROUP=primary
# ATHENA_OUTPUT_LOCATION=s3://your-bucket/athena-results/

# ═══ Server Settings ═══
MCP_SERVER_NAME=sparkling-data-explorer
MCP_LOG_LEVEL=INFO
