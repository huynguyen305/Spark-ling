# MCP Configuration for Spark-ling
# Copy this file to .env and fill in your values:
#   cp mcp/.env.example mcp/.env

# === Backend Selection ===
# Choose: "databricks", "s3", or "auto" (tries databricks first, falls back to s3)
MCP_BACKEND=auto

# === Databricks Backend ===
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi-xxxxxxxxxxxxxxxx
DATABRICKS_WAREHOUSE_ID=xxxxxxxxxxxxxxxx
DATABRICKS_CATALOG=sparkling
DATABRICKS_SCHEMA=banking

# === S3 Backend ===
S3_BUCKET=sparkling-data-your-account-id
AWS_REGION=ap-southeast-1
# AWS credentials are read from ~/.aws/credentials or IAM role

# === Server Settings ===
MCP_SERVER_NAME=sparkling-data-explorer
MCP_LOG_LEVEL=INFO
